# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This file IS committed —
# it documents which variables exist, never what they are.

POSTGRES_PASSWORD=changeme
POSTGRES_USER=postgres
POSTGRES_DB=steam_notifier

# Discord bot token, from the Developer Portal (Bot -> Reset Token). Treated
# exactly like POSTGRES_PASSWORD: absent means RuntimeError at startup, not a
# default and not a retry. A bot cannot log in with a wrong token, so there is
# nothing to recover from at runtime.
DISCORD_BOT_TOKEN=changeme

# Optional — the values below are the defaults in database.py, so a local
# compose setup does not need them. A deployed (managed) database will, and
# that is the point: the host moves in configuration, not in code.
#
# Use 127.0.0.1, NOT localhost. On Windows localhost resolves to ::1 first
# while compose binds IPv4 only, so each connect waits out an IPv6 timeout.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Seconds to wait for a connection before giving up. psycopg has NO default
# here, and without a bound an unreachable host hangs instead of failing —
# which reads as "nothing is happening" rather than "the database is down".
POSTGRES_CONNECT_TIMEOUT=10

# Optional, development only: a Discord server (guild) id to sync the slash
# commands to. A guild sync is instant; the global sync used when this is
# unset can take up to an hour to propagate. Right-click your server icon
# with developer mode on to copy its id.
#DISCORD_GUILD_ID=

# These two MUST AGREE, which is why both are configuration: Steam gates
# pricing on the requesting IP's geolocation, not on cc= alone, so a deployed
# host can be quoted a different currency than the laptop was. A price in any
# other currency is treated as a read failure and never stored (defect D1).
STEAM_COUNTRY_CODE=us
STEAM_EXPECTED_CURRENCY=USD
